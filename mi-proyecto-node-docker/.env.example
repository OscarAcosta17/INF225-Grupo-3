# Proveedor de IA (ejemplo compatible con OpenAI / Groq / xAI)
XAI_API_KEY=
XAI_MODEL=openai/gpt-oss-20b
IA_BASE_URL=https://api.groq.com/openai/v1

# Procesamiento automático al registrar evaluación o apelación (true / false)
IA_AUTO_PROCESAR=true

# Seguridad
ADMIN_TOKEN=
IA_MAX_LLAMADAS_DIA=150

# Evaluación de criterios del supervisor
IA_NOTA_BAJA_MAXIMA=3
IA_MAX_CRITERIOS_BAJOS=2

# Tiempo de espera por llamada a la IA (ms)
IA_TIMEOUT_MS=90000
